# Normalise line endings so Windows checkouts do not rewrite Python sources.
* text=auto eol=lf

# Never let Git "fix" line endings inside these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bk2 binary
*.bik binary
*.db binary
*.rpf binary

# Authored synthetic BCPack sample; its checksum covers the compressed bytes.
tests/data/bcpack_sparse_example/*.chunk binary

# Generated browser bundles are one very long line each.
site/assets/part-*.js linguist-generated=true
